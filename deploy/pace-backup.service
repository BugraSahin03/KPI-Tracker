[Unit]
Description=Pace SQLite Online-Backup
After=pace.service

[Service]
Type=oneshot
User=pace
Group=pace
WorkingDirectory=/opt/pace/current
EnvironmentFile=/etc/pace/pace.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node scripts/backup/create-backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/pace
ReadWritePaths=/var/backups/pace
RestrictSUIDSGID=true
LockPersonality=true
