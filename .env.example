# Server (bindet standardmäßig nur lokal; Zugriff auf Hetzner via Tailscale/Reverse Proxy)
HOST=127.0.0.1
PORT=4173
PACE_DATABASE_PATH=/var/lib/pace/pace.sqlite
PACE_PUBLIC_ORIGIN=https://pace.example.ts.net
# Verbindlicher Kalendertag für serverseitige Prüfungen (gültige IANA-Zeitzone)
PACE_TIME_ZONE=Europe/Berlin
# In Produktion verpflichtend. Kommagetrennte Tailscale-Logins von Bugra und Sena.
PACE_ALLOWED_TAILSCALE_USERS=bugra@example.com,sena@example.com
PACE_BACKUP_DIR=/var/backups/pace
PACE_BACKUP_RETENTION_DAYS=30

# Google Health API v4 – vorläufig bewusst ausgeschaltet.
# Erst nach Fertigstellung der App auf true setzen; false startet weder OAuth-Routen noch Polling.
PACE_GOOGLE_HEALTH_ENABLED=false
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Erzeugen: openssl rand -base64 32
PACE_TOKEN_ENCRYPTION_KEY=
GOOGLE_HEALTH_POLL_MINUTES=15
GOOGLE_HEALTH_INITIAL_SYNC_DAYS=365
# Bei Folgesyncs werden verspätet hochgeladene Messungen erneut geprüft (Deduplizierung ist idempotent)
GOOGLE_HEALTH_LOOKBACK_DAYS=7

# Optional: nur mit korrekter Größe wird BMI aus Google-Gewicht berechnet
PACE_HEIGHT_CM=
