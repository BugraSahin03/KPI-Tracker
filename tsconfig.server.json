{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-server",
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/types.ts", "src/lib/storage.ts", "src/lib/date.ts"],
  "exclude": ["server/**/*.test.ts"]
}
